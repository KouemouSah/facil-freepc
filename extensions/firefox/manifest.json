{
  "manifest_version": 3,
  "name": "Facil FreePC",
  "version": "0.5.0",
  "description": "Met en veille les onglets inactifs pour liberer la memoire (jamais l'onglet actif, epingle ou qui joue du son). Une solution de la marque Facil.",
  "author": "Emac SAH",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": ["tabs", "alarms", "storage"],
  "background": {
    "scripts": ["policy.js", "background.js"]
  },
  "options_ui": {
    "page": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{cff36c27-7139-4e1a-8f80-5519fa80aa1d}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
